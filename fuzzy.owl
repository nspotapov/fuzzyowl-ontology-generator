<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/fuzzy.owl"
         xmlns="http://example.org/fuzzy.owl#">

<owl:Ontology rdf:about="http://example.org/fuzzy.owl"/>

<owl:ObjectProperty rdf:about="#hasSource">
  <rdfs:domain rdf:resource="#FuzzyRelation"/>
  <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasTarget">
  <rdfs:domain rdf:resource="#FuzzyRelation"/>
  <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#fqHasSource">
  <rdfs:domain rdf:resource="#FuzzyQualityRelation"/>
  <rdfs:range rdf:resource="#Entity"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#fqHasQuality">
  <rdfs:domain rdf:resource="#FuzzyQualityRelation"/>
  <rdfs:range rdf:resource="#Quality"/>
</owl:ObjectProperty>

<owl:AnnotationProperty rdf:about="#fuzzyDegree"/>

<owl:Class rdf:about="#Entity">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Quality">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#FuzzyRelation">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#FuzzyQualityRelation">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Система">
  <rdfs:subClassOf rdf:resource="#Entity"/>
</owl:Class>

<owl:Class rdf:about="#Надёжность">
  <rdfs:subClassOf rdf:resource="#Entity"/>
</owl:Class>

<owl:NamedIndividual rdf:about="#fuzzyrelation1">
  <rdf:type rdf:resource="#FuzzyRelation"/>
  <hasSource rdf:resource="#Система"/>
  <hasTarget rdf:resource="#Надёжность"/>
  <fuzzyDegree rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.7</fuzzyDegree>
</owl:NamedIndividual>


</rdf:RDF>
